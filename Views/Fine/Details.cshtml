@model TrahvManage.Models.FineModel

@{
    ViewBag.Title = "Üksikasjad";
}

<h2>Üksikasjad</h2>

<div>
    <dl class="dl-horizontal">
        <dt>
            Omaniku isikukood
        </dt>

        <dd>
            @Html.DisplayFor(model => model.PersonalCode)
        </dd>

        <dt>
            Auto number
        </dt>

        <dd>
            @Html.DisplayFor(model => model.AutoNumber)
        </dd>

        <dt>
            Juhtum
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Incident)
        </dd>

        <dt>
            Juhtumi koht
        </dt>

        <dd>
            @Html.DisplayFor(model => model.IncidentPlace)
        </dd>

        <dt>
            Juhtumi päev
        </dt>

        <dd>
            @Html.DisplayFor(model => model.IncidentDate)
        </dd>

        <dt>
            Trahv summa
        </dt>

        <dd>
            @Html.DisplayFor(model => model.FineAmount)
        </dd>

    </dl>
    <img src="@Html.DisplayFor(model => model.GifUrl)" alt="Juhtum" style="width:800px;height:600px;">
</div>
<p>
    @Html.ActionLink("Tagasi nimekirja", "Index")
</p>
