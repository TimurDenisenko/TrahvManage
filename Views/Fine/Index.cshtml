@model IEnumerable<TrahvManage.Models.FineModel>

@{
    ViewBag.Title = "Kodu leht";
}

<h2>Trahvid</h2>

<p>
    @{
        if (TrahvManage.Models.UserState.Role == "Admin")
        {
            Html.ActionLink("Loo uus", "Create");
        }
    }
</p>
<table class="table">
    <tr>
        <th>
            Auto number
        </th>
        <th>
            Juhtum
        </th>
        <th>
            Trahv summa
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.AutoNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Incident)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FineAmount)€
            </td>
            <td>
                @{
                    @Html.ActionLink("Üksikasjad", "Details", new { id = item.Id })
                    if (TrahvManage.Models.UserState.Role == "Admin")
                    {
                        @Html.ActionLink("| Muuda", "Edit", new { id = item.Id })
                        @Html.ActionLink("| Kustuta", "Delete", new { id = item.Id })
                    }
                }
            </td>
        </tr>
    }
</table>
