@model IEnumerable<TrahvManage.Models.ChatModel>

@{
    ViewBag.Title = "Tehniline tugi";
}

<h2>Tehniline tugi</h2>

<table class="table" style="text-align: center">
    @if (TrahvManage.Models.UserState.Role != "Admin")
    {
        <tr>
            <td>
                @Html.ActionLink("Uus vestlus", "Create")
            </td>
        </tr>
    }
    @foreach (TrahvManage.Models.ChatModel item in Model)
    {
        <tr>
            <td>
                @Html.ActionLink("Vestlus #" + item.Id, "Edit", new { id = item.Id })
            </td>
        </tr>
    }
</table>
