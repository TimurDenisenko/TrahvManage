@model TrahvManage.Models.ChatModel
@{
    string fp = ViewBag.FirstPerson;
    string sp = ViewBag.SecondPerson;
}
<h2>Vestlus</h2>

<style>
    textarea {
        resize: none;
        min-width: 1275px;
    }
</style>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div @*style="overflow-y: scroll; height: 300px;" id="scrollableDiv"*@>
        @foreach (Tuple<string, string> item in TrahvManage.Models.HistoryConverter.ConvertFromString(Model.History))
        {
            <div>
                @if (item.Item1 == Model.FirstPersonalCode)
                {
                    <p>@fp - @item.Item2</p>
                }
                else
                {
                    <p>@sp - @item.Item2</p>
                }
            </div>
        }
    </div>
    <script>
        function scrollToBottom() {
            var div = document.getElementById("scrollableDiv");
            div.scrollTop = div.scrollHeight;
        }
        window.onload = scrollToBottom;
    </script>
    <div @*style="display: inline-flex"*@>
        @Html.TextAreaFor(model => model.History)
        <script>
            document.getElementById("History").value = "";
        </script>
        <input type="submit" value="Saada" class="btn btn-default" />
    </div>
}

<div>
    @Html.ActionLink("Tagasi", "Index")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
